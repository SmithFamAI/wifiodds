# .slopignore — what the pre-commit prose check skips in this repo.
# One glob per line, # for comments, a trailing / means everything underneath.
# Read by build/slop-gate.js --staged (see scripts/install-slop-hook.sh in ~/websites).
#
# Everything here is skipped for a reason, and the reason is written down.

# Every served page in this repo is written by build/prerender.js. The build's own
# ratchet already checks all of them against build/slop-baseline.json, which is a
# stricter check than the hook's. Checking them here would score generated bytes
# twice and block a commit for prose that lives in build/lib/.
**/*.html
llms.txt

# Generated the same way, from assets/airlines.js.
functions/_lib/score.mjs
